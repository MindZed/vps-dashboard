# ==========================================
# MindZed Hub Web - Environment Configuration
# ==========================================

# URL pointing to the Go VPS daemon behind Cloudflare Tunnel
NEXT_PUBLIC_AGENT_URL=https://agent.mindzed.tech
AGENT_URL=https://agent.mindzed.tech

# Secret key matching the AGENT_SECRET on the Oracle VPS
NEXT_PUBLIC_AGENT_SECRET=dfb2bd78acdzfdxarf379161b46bd31e0890610fab9028x1
AGENT_SECRET=replace_with_your_own_32_char_secret_key

# ------------------------------------------
# GitHub OAuth (Zero Database Authentication)
# ------------------------------------------
# Create an OAuth App in GitHub Settings > Developer Settings > OAuth Apps
# Homepage URL: https://dash.mindzed.tech
# Authorization callback URL: https://dash.mindzed.tech/api/auth/callback/github
# (For local testing: http://localhost:3000/api/auth/callback/github)
GITHUB_ID=your_github_oauth_client_id
GITHUB_SECRET=your_github_oauth_client_secret
NEXTAUTH_SECRET=generate_any_random_32_char_secret
NEXTAUTH_URL=https://dash.mindzed.tech

# Optional: Hardcoded fallback whitelist (in addition to in-app whitelist)
ALLOWED_GITHUB_USERS=Seven,friend_dev

# ------------------------------------------
# (Optional) External Uptime Kuma Endpoint
# ------------------------------------------
NEXT_PUBLIC_KUMA_URL=https://status.mindzed.tech
