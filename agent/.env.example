# ==========================================
# MindZed Agent - Environment Configuration
# ==========================================

# Server Listening Port
PORT=8080
GIN_MODE=release

# Shared Secret for Authenticating Hub Requests (Required!)
# Sent in the "X-Agent-Secret" header
# Generate with: openssl rand -hex 32
AGENT_SECRET=replace_with_your_own_32_char_secret_key

# Local JSON file path for GitHub Admin & Whitelist persistence (0 PostgreSQL tables!)
WHITELIST_FILE=whitelist.json

# ------------------------------------------
# PostgreSQL Master Connection
# ------------------------------------------
# Option A: Direct Connection URL
DATABASE_URL=postgres://postgres:your_master_password@postgres:5432/postgres?sslmode=disable

# Option B: Granular parameters (used if DATABASE_URL is not provided)
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_master_password
PG_DATABASE=postgres
PG_SSLMODE=disable

# ------------------------------------------
# Connection String Output Format (Provided to Next.js Hub)
# ------------------------------------------
# Dokploy Swarm internal service name (e.g. your Dokploy postgres service name)
PG_INTERNAL_HOST=postgres

# Public VPS IP or domain for external connections (e.g. your VPS public IP or db.yourdomain.com)
PG_EXTERNAL_HOST=your_vps_public_ip_or_domain

# PgBouncer Connection Pooler port for external/serverless connections (default: 6432)
PGBOUNCER_PORT=6432

# Local port for SSH Tunnel forwarding (e.g. ssh -L 5433:postgres:5432 opc@vps)
SSH_LOCAL_PORT=5433
